# Base de datos local (SQLite). En producción puede ser un volumen persistente.
DATABASE_PATH=./reservas.db

# Clave que Mirlo envía en el header "X-API-Key" al llamar a las herramientas.
AGENT_API_KEY=cambia-esta-clave

# Adaptador de TRYTN: "mock" (pruebas) o "http" (producción).
TRYTN_MODE=mock
TRYTN_BASE_URL=https://api.trytn.com
TRYTN_API_KEY=
# Secreto para verificar la firma HMAC-SHA256 de los webhooks de TRYTN.
TRYTN_WEBHOOK_SECRET=cambia-este-secreto

# Webhook de Mirlo para avisar al cliente cuando se confirma el pago (opcional).
MIRLO_NOTIFY_URL=
MIRLO_API_KEY=

# Minutos que se aparta un lugar mientras el agente toma los datos del cliente.
HOLD_MINUTES=10
# Minutos que tiene el cliente para pagar el link antes de liberar el lugar.
PAYMENT_MINUTES=30
